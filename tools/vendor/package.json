{
  "name": "quarto-simulator-vendor",
  "private": true,
  "type": "module",
  "description": "Builds the bundle (CodeMirror, js-yaml, the WASI shim and the renderer) used by the quarto-simulator extension.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=esm --legal-comments=external --outfile=../../_extensions/quarto-simulator/resources/vendor.js",
    "build-quarto-runtime": "node build-quarto-runtime.mjs"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.12",
    "js-yaml": "^4.3.2"
  }
}
